.pm {
  z-index: 2000;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(33,26,33,0.95);
  justify-content: center;
  align-items: center;
  padding: 12px;
}

.pmc {
  background: #211a21;
  border: 2px solid #4f43ae;
  width: 100%;
  max-width: 300px;
  padding: 16px;
  text-align: center;
}

.pmc p {
  margin-bottom: 14px;
  color: #b5b6e4;
  font-size: 0.9rem;
}

.pmc button {
  background: #4f43ae;
  color: #cec9cc;
  border: none;
  padding: 8px 20px;
  font-weight: 700;
  cursor: pointer;
  font-size: 0.9rem;
  margin: 0 4px;
  transition: all 0.2s;
}

.pmc button:hover {
  background: #b5b6e4;
  color: #211a21;
}